NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI-assisted workbook interpretation. Keep all secrets server-side.
OPENAI_API_KEY=
# Set a Responses API model that supports strict structured outputs.
OPENAI_WORKFLOW_MODEL=gpt-6-luna
# Optional Typesafe System One confidence routing (jev-latest).
TYPESAFE_API_KEY=

# Optional: speech-to-text provider
TRANSCRIPTION_API_KEY=

# Optional public HTTPS URL to an actual hosted TeacherCo beta APK. Hidden if unset.
NEXT_PUBLIC_ANDROID_APK_URL=

# Public SHA-256 certificate fingerprints, comma-separated (AA:BB:... format).
# Set only after inspecting the actual release / Play app-signing certificate.
ANDROID_SHA256_CERT_FINGERPRINTS=
